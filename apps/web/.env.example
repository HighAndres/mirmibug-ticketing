DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
INTERNAL_API_KEY="your-secret-key-here"

# URL pública de la app (se usa en los links de los correos)
NEXTAUTH_URL="http://localhost:3000"

# Directorio raíz de la app, donde vive /public (subida de logos y adjuntos).
# En producción apuntar a la ruta absoluta de apps/web. Si se omite, se usa el CWD del proceso.
# APP_DIR="/ruta/a/apps/web"

# Llave para cifrar secretos en BD (contraseña SMTP). REQUERIDA para la config
# de correo por UI. Generar con: openssl rand -base64 32
# NO cambiar una vez en uso (la contraseña SMTP guardada dejaría de descifrarse).
SETTINGS_ENC_KEY="generate-with-openssl-rand-base64-32"

# SMTP: ahora se gestiona desde la UI (Configuración → Correo, solo SUPERADMIN),
# guardado en la tabla EmailSettings. Las variables SMTP_* de abajo son solo un
# fallback opcional si prefieres configurarlo por entorno; la config de BD tiene
# precedencia. Sin host (ni en BD ni aquí) los correos solo se registran en consola.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mirmibug <notificaciones@mirmiapps.com>"

# Seed (prisma db seed). El seed NO corre con NODE_ENV=production salvo que
# definas SEED_ALLOW_PRODUCTION=1. Las contraseñas de las cuentas de demo se
# leen de estas variables; si faltan se genera una aleatoria y se imprime una
# sola vez. Nunca uses contraseñas fijas del repositorio en producción.
# SEED_ALLOW_PRODUCTION="0"
# SEED_ADMIN_PASSWORD=""
# SEED_AGENT_PASSWORD=""
# SEED_CLIENT_ADMIN_PASSWORD=""
# SEED_SUPERVISOR_PASSWORD=""
# SEED_CLIENT_USER_PASSWORD=""
