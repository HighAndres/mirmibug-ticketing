DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
INTERNAL_API_KEY="your-secret-key-here"

# URL pública de la app (se usa en los links de los correos)
NEXTAUTH_URL="http://localhost:3000"

# Directorio raíz de la app, donde vive /public (subida de logos y adjuntos).
# En producción apuntar a la ruta absoluta de apps/web. Si se omite, se usa el CWD del proceso.
# APP_DIR="/ruta/a/apps/web"

# Llave para cifrar secretos en BD (contraseña SMTP). REQUERIDA para la config
# de correo por UI. Generar con: openssl rand -base64 32
# NO cambiar una vez en uso (la contraseña SMTP guardada dejaría de descifrarse).
SETTINGS_ENC_KEY="generate-with-openssl-rand-base64-32"

# SMTP: ahora se gestiona desde la UI (Configuración → Correo, solo SUPERADMIN),
# guardado en la tabla EmailSettings. Las variables SMTP_* de abajo son solo un
# fallback opcional si prefieres configurarlo por entorno; la config de BD tiene
# precedencia. Sin host (ni en BD ni aquí) los correos solo se registran en consola.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mirmibug <notificaciones@mirmiapps.com>"

# ── Integración WhatsApp (vía n8n) ───────────────────────────────────────────
# Interruptor maestro. Con false, los endpoints /api/v1/integrations/* responden
# 404 y no se emiten eventos al outbox.
WHATSAPP_INTEGRATION_ENABLED=false
# Límites por minuto: por API key en toda la API de integración, y por teléfono
# en los endpoints de escritura (comentarios, tickets, adjuntos).
INTEGRATION_RATE_LIMIT_PER_MIN=60
WHATSAPP_PHONE_RATE_LIMIT_PER_MIN=20
# Tamaño máximo de un adjunto recibido por WhatsApp (MB)
ATTACHMENT_MAX_MB=16
# Días tras RESOLVED/CLOSED en los que el cliente aún puede reabrir desde WhatsApp
TICKET_REOPEN_MAX_DAYS=7
# Timeout del POST a cada webhook saliente (segundos)
WEBHOOK_TIMEOUT_SECONDS=10
# Categoría que reciben los tickets creados por WhatsApp cuando n8n no manda
# category_id. Debe existir en el catálogo; si no, se usa la primera por nombre.
WHATSAPP_DEFAULT_CATEGORY="Soporte técnico"
# Webhook de n8n que recibe los eventos (ticket.created, etc.) y secreto HMAC.
# Sirven de semilla para el primer WebhookEndpoint; después se gestionan desde la UI.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Outbox de eventos salientes: cada cuánto revisa el scheduler (segundos),
# eventos por pasada, y si se intenta entregar justo después de cada cambio.
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_IMMEDIATE_DISPATCH=true
